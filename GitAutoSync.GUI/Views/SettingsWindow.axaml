<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitAutoSync.GUI.ViewModels"
        x:Class="GitAutoSync.GUI.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings"
        Width="620" Height="420"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0"
                   Text="Open with applications"
                   FontSize="16" FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="These applications appear as buttons on the selected repository. Use {path} as a placeholder for the repository folder. Commands run with the repository as working directory, so cwd-based CLIs work too (e.g. /usr/local/bin/fork open)."
                   FontSize="12"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Margin="0,4,0,12" />

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="140,*,72" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Text="Name" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                <TextBlock Grid.Column="1" Text="Command" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                           Margin="8,0,0,0" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="140,*,72" Margin="0,0,0,6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Name}"
                                         Watermark="Name" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Command}"
                                         Watermark="command &quot;{path}&quot;"
                                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                         Margin="8,0,0,0" />
                                <Button Grid.Column="2"
                                        Content="Remove"
                                        Command="{Binding $parent[Window].DataContext.RemoveAppCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="8,0,0,0"
                                        Padding="8,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Content="Add Application..."
                    Click="AddApplicationButton_OnClick"
                    IsEnabled="{Binding CanAddApp}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding AppCountText}"
                       FontSize="11"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="12,0" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="CancelButton_OnClick"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    Content="Save"
                    Click="SaveButton_OnClick"
                    Classes="accent" />
        </Grid>
    </Grid>
</Window>
